<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>org.lifeline.waistmotion</string>
<key>CFBundleName</key><string>LIFELINE Waist Motion</string>
<key>CFBundleExecutable</key><string>ClubMotionBridge</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>0.1.0</string>
<key>CFBundleVersion</key><string>1</string>
<key>NSMotionUsageDescription</key><string>LIFELINE reads real motion from your waist-mounted AirPod to assess a possible incident.</string>
<key>NSBluetoothAlwaysUsageDescription</key><string>LIFELINE uses your connected waist-mounted AirPod for motion.</string>
<key>NSAppTransportSecurity</key><dict><!-- The relay is plain ws/http on this Mac, the LAN or a Tailscale
     peer. NSAllowsLocalNetworking exempts loopback and the RFC1918 ranges but NOT Tailscale's 100.64/10, so
     it refused every tailnet address with NSURLErrorAppTransportSecurityRequiresSecureConnection. The keys
     cannot be combined: NSAllowsLocalNetworking makes NSAllowsArbitraryLoads ignored on macOS 10.15+. -->
<key>NSAllowsArbitraryLoads</key><true/></dict>
</dict></plist>
