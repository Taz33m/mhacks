{
  "name": "lifeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "reset": "node scripts/reset-run.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "start:demo": "LIFELINE_DEMO_MODE=1 node --env-file-if-exists=.env src/server.ts",
    "start:dispatch": "LIFELINE_DISPATCH_MODE=simulated node --env-file-if-exists=.env src/server.ts",
    "ai:local": "zsh scripts/start-local-ai.sh",
    "test": "node --test src/*.test.ts src/providers/*.test.ts native/freewili/*.test.ts scripts/*.test.ts",
    "smoke:voice": "node --env-file-if-exists=.env scripts/wili-voice-smoke.ts",
    "smoke:incident": "node --env-file-if-exists=.env scripts/incident-flow-smoke.ts",
    "smoke:care": "node --env-file-if-exists=.env scripts/care-flow-smoke.ts",
    "typecheck": "tsc --noEmit",
    "setup:local": "node --env-file-if-exists=.env scripts/setup-local.ts",
    "install:airpods": "zsh native/macos/install.sh --open",
    "build:airpods": "zsh native/macos/build.sh",
    "build:eta": "zsh native/macos/build-route-eta.sh",
    "build:ios": "zsh native/ios/build.sh",
    "build:ios:device": "zsh native/ios/build-device.sh",
    "install:ios": "zsh native/ios/install-device.sh",
    "replay:motion": "node scripts/replay-motion.ts",
    "summary:detection": "node scripts/detection-summary.ts",
    "device:usb": "node scripts/connect-usb.ts",
    "setup:freewili": "zsh native/freewili/setup.sh",
    "device:freewili": "node --env-file-if-exists=.env native/freewili/stock-bridge.ts",
    "prepare:wili:ui": "python3 scripts/prepare-wili-ui.py",
    "build:location": "node scripts/build-location-view.mjs",
    "prepare:wili:local": "node native/freewili/prepare-stock-audio.ts --provider local",
    "prepare:wili:elevenlabs": "node --env-file-if-exists=.env native/freewili/prepare-stock-audio.ts --provider elevenlabs && node --env-file-if-exists=.env native/freewili/prepare-movement-audio.ts",
    "check:photon": "node scripts/photon-readiness.ts",
    "twin:export": "node scripts/digital-twin/export-traces.mjs --offline-only",
    "prepare:wili:movement": "node --env-file-if-exists=.env native/freewili/prepare-movement-audio.ts",
    "postinstall": "node scripts/patch-spectrum-polls.mjs"
  },
  "dependencies": {
    "@photon-ai/advanced-imessage": "2.2.0",
    "@spectrum-ts/core": "^12.10.1",
    "@spectrum-ts/imessage": "^12.10.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "esbuild": "0.28.2",
    "three": "0.186.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@opentelemetry/core": "2.8.0"
  }
}
