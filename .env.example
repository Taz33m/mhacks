# Copy to .env. The runtime creates a private pairing token in data/.
LIFELINE_HOST=127.0.0.1
LIFELINE_PORT=8877
# Explicit hackathon profile: 1 accelerates new check-ins to 5 seconds.
# npm run start:demo enables it; normal mode keeps LIFELINE_CHECKIN_MS.
LIFELINE_DEMO_MODE=0
LIFELINE_CHECKIN_MS=20000
# Serialize Photon sends, prioritizing alerts and conversation over routine updates.
# This is our demo pacing setting, not a provider quota.
LIFELINE_MESSAGE_GAP_MS=5000
LIFELINE_ACCEPT_MS=60000
LIFELINE_PROGRESS_MS=120000

# Demo human Maya automatically accepts, departs, arrives and records an outcome.
# Simulated actions are labelled and never sent to a real responder phone.
# Wearer Photon messaging and sensor acquisition retain their real sources.
LIFELINE_DISPATCH_MODE=live
# Opt-in sensitive check-in on paired chest/waist motion, without post-event stillness.
# This does not confirm a fall or predict an unavoidable fall.
LIFELINE_DETECTION_PROFILE=fall-confirmation
# Optional shorter local rehearsal pacing; does not change the wearer check-in.
# LIFELINE_SIMULATED_STEP_MS=1000

# Default live responders have no real phone numbers: alerts cannot be delivered.
# Set approved E.164 phones here to enable actual coordination after opting in.
# LIFELINE_RESPONDERS_JSON=[{"id":"maya","name":"Maya","phone":null},{"id":"jordan","name":"Jordan","phone":null}]

# Approved wearer E.164 phone for the companion Photon iMessage check-in.
# Keep it distinct from responder numbers; blank leaves wearer messaging unavailable.
LIFELINE_WEARER_PHONE=
# Display name attached to the wearer's exact spoken report.
LIFELINE_WEARER_NAME=Wearer

# Daily companionship conversation on the same approved Photon line.
# Local calendar scheduling handles daylight-saving changes; backend must be running.
LIFELINE_WELLBEING_ENABLED=1
LIFELINE_WELLBEING_HOUR=14
LIFELINE_WELLBEING_TIMEZONE=America/New_York

# Native Photon Find My is the default: one sharing card in the accepted iMessage chat.
# The phone owner must accept sharing in Messages. No public URL is required.
LIFELINE_FIND_MY_ENABLED=1
# Optional browser fallback: public HTTPS origin forwards only the scoped sharing page/API.
# Never point the public tunnel directly at the full backend.
LIFELINE_LOCATION_PUBLIC_URL=
LIFELINE_LOCATION_GATEWAY_PORT=8879

SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Used for cached board prompts and live responder reply speech.
ELEVENLABS_API_KEY=
# Optional board voice/model overrides; blank uses the preparer's defaults.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
# Board speech defaults to 0.85 speed; optional override is 0.7–1.2.
ELEVENLABS_SPEED=

# Optional FREE-WILi microphone recognition on the Mac. Use actual absolute paths.
# Temporarily silence wearable speaker playback across bridge restarts.
LIFELINE_WILI_MUTED=0
# The bridge verifies this actual board setting before speaker playback.
LIFELINE_WILI_VOLUME=5
# LIFELINE_WHISPER_MODEL=/absolute/path/to/ggml-tiny.en.bin
# WHISPER_CLI=/absolute/path/to/whisper-cli

LIFELINE_LLM_API_KEY=
# OpenAI-compatible server API base (ending in /v1); configure the model you use.
LIFELINE_LLM_BASE_URL=
LIFELINE_LLM_MODEL=
